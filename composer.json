{
    "name": "zuzsso/math",
    "description": "Common shareable functionality",
    "type": "library",
    "authors": [
        {
            "name": "Nico Santamaria",
            "email": "ndsans@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Math\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Math\\Tests\\": "tests/"
        }
    },
    "require": {
        "php-di/php-di": "^7.0",
        "ext-json": "*",
        "zuzsso/di-manifest": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpmd/phpmd": "@stable",
        "friendsofphp/php-cs-fixer": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/zuzsso/di-manifest"
        }
    ]
}
